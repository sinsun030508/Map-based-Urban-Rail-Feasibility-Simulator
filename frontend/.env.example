# VWorld 인증키 (https://www.vworld.kr → 오픈API → 인증키 발급, 도메인에 localhost 등록)
# 비워 두면 OpenFreeMap 타일로 자동 대체된다.
VITE_VWORLD_KEY=

# 백엔드 주소. 비워 두면 http://localhost:8080 을 쓴다.
# Hyper-V 가 8080 을 포함한 범위를 예약해 버린 PC 에서는 다른 포트로 바꾼다.
#   netsh int ipv4 show excludedportrange protocol=tcp
# 백엔드도 같은 포트로 띄워야 한다 (--server.port=9090)
VITE_API_TARGET=
