# DB (docker-compose 와 백엔드가 함께 읽는다)
DB_PASSWORD=railfeas
DB_HOST=localhost
DB_PORT=3307   # docker compose 가 3307 로 노출한다 (로컬 MySQL 과 충돌 회피)
DB_USER=root

# 외부 API
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
KAKAO_REST_KEY=

# 인증 — JWT 비밀키는 HS256 이라 32바이트 이상이어야 한다
JWT_SECRET=railfeas-local-dev-secret-key-change-me-32bytes
JWT_EXPIRY_MINUTES=720

# 소셜 로그인 (구글·카카오 개발자 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 소셜 로그인 성공 후 토큰을 붙여 보낼 프론트엔드 주소
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback

# 서울 열린데이터광장 (data.seoul.go.kr) — 지하철 승하차·역사마스터
SEOUL_OPENAPI_KEY=5250626255746c7339335372675041
