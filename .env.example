# DB (docker-compose 와 백엔드가 함께 읽는다)
# **값을 여기 적지 말 것** — 이 파일은 저장소에 올라간다. 직접 정한 비밀번호를 .env 에만 넣는다
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3307   # docker compose 가 3307 로 노출한다 (로컬 MySQL 과 충돌 회피)
DB_USER=root

# 외부 API
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
KAKAO_REST_KEY=

# 인증 — JWT 비밀키는 HS256 이라 32바이트 이상이어야 한다
# 무작위로 만들어 .env 에만 넣는다 — 예: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRY_MINUTES=720

# 소셜 로그인 (구글·카카오 개발자 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 소셜 로그인 성공 후 토큰을 붙여 보낼 프론트엔드 주소
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback

# 서울 열린데이터광장 (data.seoul.go.kr → 인증키 신청) — 지하철 승하차·역사마스터·혼잡도
# **실제 키를 여기 적지 말 것.** 이 파일은 저장소에 올라간다 — .env 에만 넣는다
SEOUL_OPENAPI_KEY=

# 공공데이터포털(data.go.kr) 일반 인증키 — Decoding 키.
# 한국철도공사 철도 자료(열차운행정보 등)를 받는 데 쓴다. 활용신청은 자동승인이다.
# **값을 여기 적지 말 것** — 이 파일은 저장소에 올라간다. 실제 값은 .env 에만.
DATA_GO_KR_KEY=
